From: SIBOS Project <sibos@example.org>
Date: Thu, 5 Dec 2024 00:00:00 +0000
Subject: [PATCH] gtkwindow: Use X11 Shape extension for rounded corners on non-composited displays

On non-composited X11, GTK falls back to .solid-csd which has no rounded
corners. This patch uses the X11 Shape extension (ShapeBounding) to create
rounded window corners without requiring a compositor.

The implementation:
1. Creates a cairo_region_t approximating the rounded rectangle using scanlines
2. Applies the region as the window's bounding shape via gdk_window_shape_combine_region()
3. Only activates when client_decorated is true but use_client_shadow is false

This maintains full compatibility with composited displays while enabling
rounded corners on window managers like SBWM, i3, dwm, etc.

Signed-off-by: SIBOS Project <sibos@example.org>
---
 gtk/gtkwindow.c | 186 ++++++++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 186 insertions(+)

diff --git a/gtk/gtkwindow.c b/gtk/gtkwindow.c
index 1234567890..abcdef1234 100644
--- a/gtk/gtkwindow.c
+++ b/gtk/gtkwindow.c
@@ -71,6 +71,10 @@
 #include "x11/gdkx.h"
 #endif

+#ifdef GDK_WINDOWING_X11
+#include <math.h>
+#endif
+
 #include "a11y/gtkwindowaccessible.h"
 #include "a11y/gtkcontaineraccessibleprivate.h"

@@ -271,6 +275,9 @@ struct _GtkWindowPrivate
   guint    unlimited_guessed_size_y  : 1;
   guint    force_resize              : 1;
   guint    fixup_maximize_allocation : 1;
+#ifdef GDK_WINDOWING_X11
+  guint    x11_shape_applied         : 1; /* Whether bounding shape has been applied */
+#endif

   GdkWindowTypeHint type_hint;

@@ -4165,6 +4172,162 @@ gtk_window_supports_client_shadow (GtkWindow *window)
   return FALSE;
 }

+#ifdef GDK_WINDOWING_X11
+/**
+ * create_rounded_corner_region:
+ * @width: Window width in pixels
+ * @height: Window height in pixels
+ * @radius: Corner radius in pixels
+ *
+ * Creates a cairo_region_t representing a rounded rectangle.
+ * Uses scanline approximation for the corners to work with
+ * X11's rectangle-based shape regions.
+ *
+ * Returns: (transfer full): A new cairo_region_t, or %NULL on error
+ */
+static cairo_region_t *
+create_rounded_corner_region (int width,
+                              int height,
+                              int radius)
+{
+  cairo_region_t *region;
+  cairo_rectangle_int_t rect;
+  int y, x_offset;
+  double r_squared;
+
+  if (width <= 0 || height <= 0)
+    return NULL;
+
+  /* Clamp radius to half of smallest dimension */
+  if (radius > width / 2)
+    radius = width / 2;
+  if (radius > height / 2)
+    radius = height / 2;
+  if (radius < 1)
+    radius = 0;
+
+  region = cairo_region_create ();
+  if (region == NULL)
+    return NULL;
+
+  if (radius == 0)
+    {
+      /* No rounding needed, return full rectangle */
+      rect.x = 0;
+      rect.y = 0;
+      rect.width = width;
+      rect.height = height;
+      cairo_region_union_rectangle (region, &rect);
+      return region;
+    }
+
+  r_squared = (double)radius * (double)radius;
+
+  /* Top rounded portion - scanline by scanline */
+  for (y = 0; y < radius; y++)
+    {
+      double dy = radius - y - 0.5; /* Distance from center of corner circle */
+      double dx_squared = r_squared - dy * dy;
+
+      if (dx_squared > 0)
+        x_offset = radius - (int)(sqrt (dx_squared) + 0.5);
+      else
+        x_offset = radius;
+
+      /* Clamp to valid range */
+      if (x_offset < 0)
+        x_offset = 0;
+      if (x_offset > radius)
+        x_offset = radius;
+
+      rect.x = x_offset;
+      rect.y = y;
+      rect.width = width - 2 * x_offset;
+      rect.height = 1;
+
+      if (rect.width > 0)
+        cairo_region_union_rectangle (region, &rect);
+    }
+
+  /* Middle portion - full width */
+  if (height > 2 * radius)
+    {
+      rect.x = 0;
+      rect.y = radius;
+      rect.width = width;
+      rect.height = height - 2 * radius;
+      cairo_region_union_rectangle (region, &rect);
+    }
+
+  /* Bottom rounded portion - scanline by scanline */
+  for (y = 0; y < radius; y++)
+    {
+      double dy = y + 0.5; /* Distance from center of corner circle */
+      double dx_squared = r_squared - dy * dy;
+
+      if (dx_squared > 0)
+        x_offset = radius - (int)(sqrt (dx_squared) + 0.5);
+      else
+        x_offset = radius;
+
+      /* Clamp to valid range */
+      if (x_offset < 0)
+        x_offset = 0;
+      if (x_offset > radius)
+        x_offset = radius;
+
+      rect.x = x_offset;
+      rect.y = height - radius + y;
+      rect.width = width - 2 * x_offset;
+      rect.height = 1;
+
+      if (rect.width > 0)
+        cairo_region_union_rectangle (region, &rect);
+    }
+
+  return region;
+}
+
+/**
+ * update_x11_bounding_shape:
+ * @window: A #GtkWindow
+ *
+ * Updates the X11 bounding shape for the window to create
+ * rounded corners without compositor support.
+ */
+static void
+update_x11_bounding_shape (GtkWindow *window)
+{
+  GtkWindowPrivate *priv = window->priv;
+  GtkWidget *widget = GTK_WIDGET (window);
+  GdkWindow *gdk_window;
+  cairo_region_t *region;
+  int width, height, radius;
+
+  gdk_window = _gtk_widget_get_window (widget);
+  if (gdk_window == NULL)
+    return;
+
+  if (!GDK_IS_X11_WINDOW (gdk_window))
+    return;
+
+  width = gdk_window_get_width (gdk_window);
+  height = gdk_window_get_height (gdk_window);
+
+  /* Default corner radius for CSD windows - matches typical GTK themes */
+  radius = 8;
+
+  /* Try to get border-radius from CSS if possible */
+  {
+    GtkStyleContext *context;
+    GtkStateFlags state;
+    gint css_radius = 0;
+
+    context = gtk_widget_get_style_context (widget);
+    state = gtk_style_context_get_state (context);
+
+    gtk_style_context_get (context, state,
+                           GTK_STYLE_PROPERTY_BORDER_RADIUS, &css_radius,
+                           NULL);
+
+    if (css_radius > 0)
+      radius = css_radius;
+  }
+
+  /* For maximized/fullscreen windows, use square corners */
+  if (priv->maximized || priv->fullscreen)
+    radius = 0;
+
+  region = create_rounded_corner_region (width, height, radius);
+  if (region != NULL)
+    {
+      gdk_window_shape_combine_region (gdk_window, region, 0, 0);
+      cairo_region_destroy (region);
+      priv->x11_shape_applied = TRUE;
+    }
+}
+
+/**
+ * clear_x11_bounding_shape:
+ * @window: A #GtkWindow
+ *
+ * Clears the X11 bounding shape, restoring rectangular window.
+ */
+static void
+clear_x11_bounding_shape (GtkWindow *window)
+{
+  GtkWindowPrivate *priv = window->priv;
+  GtkWidget *widget = GTK_WIDGET (window);
+  GdkWindow *gdk_window;
+
+  gdk_window = _gtk_widget_get_window (widget);
+  if (gdk_window == NULL)
+    return;
+
+  if (!GDK_IS_X11_WINDOW (gdk_window))
+    return;
+
+  if (priv->x11_shape_applied)
+    {
+      gdk_window_shape_combine_region (gdk_window, NULL, 0, 0);
+      priv->x11_shape_applied = FALSE;
+    }
+}
+#endif /* GDK_WINDOWING_X11 */
+
 static void
 gtk_window_enable_csd (GtkWindow *window)
 {
@@ -4181,6 +4344,12 @@ gtk_window_enable_csd (GtkWindow *window)
   else
     {
       gtk_style_context_add_class (gtk_widget_get_style_context (widget), "solid-csd");
+
+#ifdef GDK_WINDOWING_X11
+      /* On non-composited X11, use Shape extension for rounded corners */
+      if (gtk_widget_get_realized (widget))
+        update_x11_bounding_shape (window);
+#endif
     }

   priv->client_decorated = TRUE;
@@ -7387,6 +7556,13 @@ update_realized_window_properties (GtkWindow     *window,
   if (priv->client_decorated && priv->use_client_shadow)
     update_shadow_width (window, window_border);

+#ifdef GDK_WINDOWING_X11
+  /* On non-composited X11, update the bounding shape for rounded corners */
+  if (priv->client_decorated && !priv->use_client_shadow &&
+      !priv->maximized && !priv->fullscreen)
+    update_x11_bounding_shape (window);
+#endif
+
   update_opaque_region (window, window_border, child_allocation);

   update_border_windows (window);
@@ -7626,6 +7802,11 @@ gtk_window_realize (GtkWidget *widget)
   if (priv->wm_role)
     gdk_window_set_role (gdk_window, priv->wm_role);

+#ifdef GDK_WINDOWING_X11
+  /* Apply bounding shape if we're using solid-csd */
+  if (priv->client_decorated && !priv->use_client_shadow)
+    update_x11_bounding_shape (window);
+#endif
+
   if (!priv->decorated || priv->client_decorated)
     gdk_window_set_decorations (gdk_window, 0);

@@ -9532,6 +9713,11 @@ gtk_window_state_callback (GtkWidget *widget,
       priv->maximized = (new_state & GDK_WINDOW_STATE_MAXIMIZED) ? TRUE : FALSE;
       priv->fullscreen = (new_state & GDK_WINDOW_STATE_FULLSCREEN) ? TRUE : FALSE;
       priv->tiled = (new_state & GDK_WINDOW_STATE_TILED) ? TRUE : FALSE;
+
+#ifdef GDK_WINDOWING_X11
+      /* Update shape when window state changes */
+      if (priv->client_decorated && !priv->use_client_shadow)
+        update_x11_bounding_shape (window);
+#endif
     }

   return FALSE;
--
2.43.0
