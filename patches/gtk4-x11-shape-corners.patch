From: SIBOS Project <sibos@example.org>
Date: Thu, 5 Dec 2024 00:00:00 +0000
Subject: [PATCH] gtk4: Use X11 Shape extension for rounded corners on non-composited displays

On non-composited X11, GTK4 falls back to .solid-csd which has no rounded
corners. This patch uses the X11 Shape extension (ShapeBounding) to create
rounded window corners without requiring a compositor.

The implementation adds:
1. gdk_x11_surface_set_bounding_shape() - Sets the visual bounding shape
2. create_rounded_corner_region() - Creates a cairo_region_t approximating
   the rounded rectangle using scanlines
3. update_x11_bounding_shape() - Applies the shape when needed

This maintains full compatibility with composited displays while enabling
rounded corners on window managers like SBWM, i3, dwm, etc.

Signed-off-by: SIBOS Project <sibos@example.org>
---
 gdk/x11/gdksurface-x11.c | 56 ++++++++++++++++++++++++++++
 gdk/x11/gdkx11surface.h  |  4 ++
 gtk/gtkwindow.c          | 178 ++++++++++++++++++++++++++++++++++++++++++++++++
 3 files changed, 238 insertions(+)

diff --git a/gdk/x11/gdksurface-x11.c b/gdk/x11/gdksurface-x11.c
index 1234567890..abcdef1234 100644
--- a/gdk/x11/gdksurface-x11.c
+++ b/gdk/x11/gdksurface-x11.c
@@ -3028,6 +3028,62 @@ gdk_x11_surface_set_input_region (GdkSurface     *surface,
 #endif
 }

+/**
+ * gdk_x11_surface_set_bounding_shape:
+ * @surface: a `GdkSurface`
+ * @shape_region: (nullable): the region defining the bounding shape, or %NULL to remove
+ *
+ * Sets the bounding shape for an X11 surface using the Shape extension.
+ * This defines which parts of the window are visible (non-transparent).
+ *
+ * Unlike input shapes which define where the window receives input events,
+ * the bounding shape defines the actual visible pixels of the window.
+ * This is useful for creating rounded corners on non-composited X11 displays.
+ *
+ * If @shape_region is %NULL, the shape is reset to the full window rectangle.
+ *
+ * Since: 4.16
+ */
+void
+gdk_x11_surface_set_bounding_shape (GdkSurface     *surface,
+                                    cairo_region_t *shape_region)
+{
+  GdkX11Surface *impl = GDK_X11_SURFACE (surface);
+
+  if (GDK_SURFACE_DESTROYED (surface))
+    return;
+
+  if (!gdk_display_supports_shapes (GDK_SURFACE_DISPLAY (surface)))
+    return;
+
+  if (shape_region == NULL)
+    {
+      XShapeCombineMask (GDK_SURFACE_XDISPLAY (surface),
+                         GDK_SURFACE_XID (surface),
+                         ShapeBounding,
+                         0, 0,
+                         None,
+                         ShapeSet);
+      return;
+    }
+  else
+    {
+      int n_rects = 0;
+      XRectangle *xrects = NULL;
+
+      _gdk_x11_region_get_xrectangles (shape_region,
+                                       0, 0, impl->surface_scale,
+                                       &xrects, &n_rects);
+
+      XShapeCombineRectangles (GDK_SURFACE_XDISPLAY (surface),
+                               GDK_SURFACE_XID (surface),
+                               ShapeBounding,
+                               0, 0,
+                               xrects, n_rects,
+                               ShapeSet,
+                               YXBanded);
+
+      g_free (xrects);
+    }
+}
+
 /**
  * gdk_x11_surface_set_user_time:
  * @surface: (type GdkX11Surface): A toplevel `GdkSurface`
diff --git a/gdk/x11/gdkx11surface.h b/gdk/x11/gdkx11surface.h
index 1234567890..abcdef1234 100644
--- a/gdk/x11/gdkx11surface.h
+++ b/gdk/x11/gdkx11surface.h
@@ -54,6 +54,10 @@ GDK_AVAILABLE_IN_ALL
 void     gdk_x11_surface_set_frame_sync_enabled (GdkSurface *surface,
                                                  gboolean   frame_sync_enabled);

+GDK_AVAILABLE_IN_4_16
+void     gdk_x11_surface_set_bounding_shape (GdkSurface     *surface,
+                                             cairo_region_t *shape_region);
+
 /**
  * GDK_SURFACE_XID:
  * @win: a `GdkSurface`
diff --git a/gtk/gtkwindow.c b/gtk/gtkwindow.c
index 1234567890..abcdef1234 100644
--- a/gtk/gtkwindow.c
+++ b/gtk/gtkwindow.c
@@ -71,6 +71,11 @@
 #include <gdk/x11/gdkx.h>
 #endif

+#ifdef GDK_WINDOWING_X11
+#include <gdk/x11/gdkx11surface.h>
+#include <math.h>
+#endif
+
 /**
  * GtkWindow:
  *
@@ -272,6 +277,9 @@ struct _GtkWindowPrivate
   guint    edge_constraints;
   guint    saved_edge_constraints;
   guint    is_set_maximized : 1;
+#ifdef GDK_WINDOWING_X11
+  guint    x11_shape_applied : 1;
+#endif
 };

 enum {
@@ -3159,6 +3167,154 @@ gtk_window_enable_csd (GtkWindow *window)
     {
       gtk_widget_add_css_class (widget, "solid-csd");
     }
+
+#ifdef GDK_WINDOWING_X11
+  /* Apply bounding shape for rounded corners on non-composited X11 */
+  if (!gtk_window_is_composited (window))
+    {
+      GdkSurface *surface = gtk_native_get_surface (GTK_NATIVE (window));
+      if (surface != NULL && GDK_IS_X11_SURFACE (surface))
+        {
+          GtkWindowPrivate *priv = gtk_window_get_instance_private (window);
+          if (gtk_widget_get_realized (widget))
+            update_x11_bounding_shape (window);
+        }
+    }
+#endif
+
+  priv->client_decorated = TRUE;
+}
+
+#ifdef GDK_WINDOWING_X11
+/**
+ * create_rounded_corner_region:
+ * @width: Window width in pixels
+ * @height: Window height in pixels
+ * @radius: Corner radius in pixels
+ *
+ * Creates a cairo_region_t representing a rounded rectangle.
+ * Uses scanline approximation for the corners to work with
+ * X11's rectangle-based shape regions.
+ *
+ * Returns: (transfer full): A new cairo_region_t, or %NULL on error
+ */
+static cairo_region_t *
+create_rounded_corner_region (int width,
+                              int height,
+                              int radius)
+{
+  cairo_region_t *region;
+  cairo_rectangle_int_t rect;
+  int y, x_offset;
+  double r_squared;
+
+  if (width <= 0 || height <= 0)
+    return NULL;
+
+  /* Clamp radius to half of smallest dimension */
+  if (radius > width / 2)
+    radius = width / 2;
+  if (radius > height / 2)
+    radius = height / 2;
+  if (radius < 1)
+    radius = 0;
+
+  region = cairo_region_create ();
+  if (region == NULL)
+    return NULL;
+
+  if (radius == 0)
+    {
+      /* No rounding needed, return full rectangle */
+      rect.x = 0;
+      rect.y = 0;
+      rect.width = width;
+      rect.height = height;
+      cairo_region_union_rectangle (region, &rect);
+      return region;
+    }
+
+  r_squared = (double)radius * (double)radius;
+
+  /* Top rounded portion - scanline by scanline */
+  for (y = 0; y < radius; y++)
+    {
+      double dy = radius - y - 0.5;
+      double dx_squared = r_squared - dy * dy;
+
+      if (dx_squared > 0)
+        x_offset = radius - (int)(sqrt (dx_squared) + 0.5);
+      else
+        x_offset = radius;
+
+      if (x_offset < 0)
+        x_offset = 0;
+      if (x_offset > radius)
+        x_offset = radius;
+
+      rect.x = x_offset;
+      rect.y = y;
+      rect.width = width - 2 * x_offset;
+      rect.height = 1;
+
+      if (rect.width > 0)
+        cairo_region_union_rectangle (region, &rect);
+    }
+
+  /* Middle portion - full width */
+  if (height > 2 * radius)
+    {
+      rect.x = 0;
+      rect.y = radius;
+      rect.width = width;
+      rect.height = height - 2 * radius;
+      cairo_region_union_rectangle (region, &rect);
+    }
+
+  /* Bottom rounded portion */
+  for (y = 0; y < radius; y++)
+    {
+      double dy = y + 0.5;
+      double dx_squared = r_squared - dy * dy;
+
+      if (dx_squared > 0)
+        x_offset = radius - (int)(sqrt (dx_squared) + 0.5);
+      else
+        x_offset = radius;
+
+      if (x_offset < 0)
+        x_offset = 0;
+      if (x_offset > radius)
+        x_offset = radius;
+
+      rect.x = x_offset;
+      rect.y = height - radius + y;
+      rect.width = width - 2 * x_offset;
+      rect.height = 1;
+
+      if (rect.width > 0)
+        cairo_region_union_rectangle (region, &rect);
+    }
+
+  return region;
+}
+
+static void
+update_x11_bounding_shape (GtkWindow *window)
+{
+  GtkWindowPrivate *priv = gtk_window_get_instance_private (window);
+  GtkWidget *widget = GTK_WIDGET (window);
+  GdkSurface *surface;
+  cairo_region_t *region;
+  int width, height, radius;
+
+  surface = gtk_native_get_surface (GTK_NATIVE (window));
+  if (surface == NULL || !GDK_IS_X11_SURFACE (surface))
+    return;
+
+  width = gdk_surface_get_width (surface);
+  height = gdk_surface_get_height (surface);
+
+  /* Default corner radius for CSD windows */
+  radius = 12;
+
+  /* For maximized/fullscreen windows, use square corners */
+  if (priv->maximized || priv->fullscreen)
+    radius = 0;
+
+  region = create_rounded_corner_region (width, height, radius);
+  if (region != NULL)
+    {
+      gdk_x11_surface_set_bounding_shape (surface, region);
+      cairo_region_destroy (region);
+      priv->x11_shape_applied = TRUE;
+    }
+}
+
+static void
+clear_x11_bounding_shape (GtkWindow *window)
+{
+  GtkWindowPrivate *priv = gtk_window_get_instance_private (window);
+  GdkSurface *surface;
+
+  surface = gtk_native_get_surface (GTK_NATIVE (window));
+  if (surface == NULL || !GDK_IS_X11_SURFACE (surface))
+    return;
+
+  if (priv->x11_shape_applied)
+    {
+      gdk_x11_surface_set_bounding_shape (surface, NULL);
+      priv->x11_shape_applied = FALSE;
+    }
+}
+#endif /* GDK_WINDOWING_X11 */

-  priv->client_decorated = TRUE;
-}

 /**
  * gtk_window_set_titlebar:
@@ -4220,6 +4376,13 @@ update_realized_window_properties (GtkWindow *window)
   if (!priv->client_decorated || !priv->use_client_shadow)
     return;

+#ifdef GDK_WINDOWING_X11
+  /* On non-composited X11, update the bounding shape for rounded corners */
+  if (priv->client_decorated && !priv->use_client_shadow &&
+      !priv->maximized && !priv->fullscreen)
+    update_x11_bounding_shape (window);
+#endif
+
   gtk_css_boxes_init (&css_boxes, GTK_WIDGET (window));
   border_rect = gtk_css_boxes_get_border_rect (&css_boxes);

@@ -4851,6 +5014,11 @@ gtk_window_realize (GtkWidget *widget)
     default_title = g_get_prgname ();
     gtk_window_set_title_internal (window, title, default_title);
   }
+
+#ifdef GDK_WINDOWING_X11
+  if (priv->client_decorated && !priv->use_client_shadow)
+    update_x11_bounding_shape (window);
+#endif
 }

 static void
@@ -5789,6 +5957,11 @@ gtk_window_state_flags_changed (GtkWidget     *widget,
         set_titlebar_css (window);
       }
   }
+
+#ifdef GDK_WINDOWING_X11
+  if (priv->client_decorated && !priv->use_client_shadow)
+    update_x11_bounding_shape (window);
+#endif
 }

 static void
@@ -5831,6 +6004,11 @@ surface_state_changed (GtkWidget *widget)
         gtk_widget_queue_allocate (widget);
     }

+#ifdef GDK_WINDOWING_X11
+  if (priv->client_decorated && !priv->use_client_shadow)
+    update_x11_bounding_shape (window);
+#endif
+
   old_scale = priv->scale;
   priv->scale = gtk_widget_get_scale_factor (widget);
   if (old_scale != priv->scale)
--
