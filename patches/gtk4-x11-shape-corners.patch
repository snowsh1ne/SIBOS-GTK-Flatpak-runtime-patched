+/**
+ * gdk_x11_surface_set_bounding_shape:
+ * @surface: a `GdkSurface`
+ * @shape_region: (nullable): the region defining the bounding shape
+ *
+ * Sets the bounding shape for an X11 surface using the Shape extension.
+ * This is useful for creating rounded corners on non-composited X11.
+ */
+void
+gdk_x11_surface_set_bounding_shape (GdkSurface     *surface,
+                                    cairo_region_t *shape_region)
+{
+  GdkX11Surface *impl;
+
+  g_return_if_fail (GDK_IS_X11_SURFACE (surface));
+
+  impl = GDK_X11_SURFACE (surface);
+
+  if (GDK_SURFACE_DESTROYED (surface))
+    return;
+
+  if (shape_region == NULL)
+    {
+      XShapeCombineMask (GDK_SURFACE_XDISPLAY (surface),
+                         GDK_SURFACE_XID (surface),
+                         ShapeBounding,
+                         0, 0,
+                         None,
+                         ShapeSet);
+    }
+  else
+    {
+      int n_rects = 0;
+      XRectangle *xrects = NULL;
+
+      _gdk_x11_region_get_xrectangles (shape_region,
+                                       0, 0, impl->surface_scale,
+                                       &xrects, &n_rects);
+
+      if (n_rects > 0)
+        {
+          XShapeCombineRectangles (GDK_SURFACE_XDISPLAY (surface),
+                                   GDK_SURFACE_XID (surface),
+                                   ShapeBounding,
+                                   0, 0,
+                                   xrects, n_rects,
+                                   ShapeSet,
+                                   YXBanded);
+        }
+
+      g_free (xrects);
+    }
+}
