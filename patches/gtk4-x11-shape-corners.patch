+#ifdef GDK_WINDOWING_X11
+static cairo_region_t *
+create_rounded_corner_region (int width, int height, int radius)
+{
+  cairo_region_t *region;
+  cairo_rectangle_int_t rect;
+  int y;
+
+  if (width <= 0 || height <= 0)
+    return NULL;
+
+  if (radius > width / 2)
+    radius = width / 2;
+  if (radius > height / 2)
+    radius = height / 2;
+  if (radius < 1)
+    return NULL;
+
+  region = cairo_region_create ();
+
+  /* Top rounded section */
+  for (y = 0; y < radius; y++)
+    {
+      double dy = radius - y - 0.5;
+      int x_off = radius - (int)(sqrt (radius * radius - dy * dy) + 0.5);
+      if (x_off < 0) x_off = 0;
+
+      rect.x = x_off;
+      rect.y = y;
+      rect.width = width - 2 * x_off;
+      rect.height = 1;
+      if (rect.width > 0)
+        cairo_region_union_rectangle (region, &rect);
+    }
+
+  /* Middle section */
+  if (height > 2 * radius)
+    {
+      rect.x = 0;
+      rect.y = radius;
+      rect.width = width;
+      rect.height = height - 2 * radius;
+      cairo_region_union_rectangle (region, &rect);
+    }
+
+  /* Bottom rounded section */
+  for (y = 0; y < radius; y++)
+    {
+      double dy = y + 0.5;
+      int x_off = radius - (int)(sqrt (radius * radius - dy * dy) + 0.5);
+      if (x_off < 0) x_off = 0;
+
+      rect.x = x_off;
+      rect.y = height - radius + y;
+      rect.width = width - 2 * x_off;
+      rect.height = 1;
+      if (rect.width > 0)
+        cairo_region_union_rectangle (region, &rect);
+    }
+
+  return region;
+}
+
+static void
+update_x11_bounding_shape (GtkWindow *window)
+{
+  GtkWindowPrivate *priv = gtk_window_get_instance_private (window);
+  GdkSurface *surface;
+  cairo_region_t *region;
+  int width, height, radius;
+
+  if (!gtk_widget_get_realized (GTK_WIDGET (window)))
+    return;
+
+  surface = gtk_native_get_surface (GTK_NATIVE (window));
+  if (surface == NULL)
+    return;
+
+  if (!GDK_IS_X11_SURFACE (surface))
+    return;
+
+  /* Check if composited - if so, no shape needed */
+  if (gdk_display_is_composited (gtk_widget_get_display (GTK_WIDGET (window))))
+    return;
+
+  width = gdk_surface_get_width (surface);
+  height = gdk_surface_get_height (surface);
+  radius = 12;
+
+  /* Square corners for maximized/fullscreen */
+  if (priv->maximized || priv->fullscreen)
+    {
+      gdk_x11_surface_set_bounding_shape (surface, NULL);
+      priv->x11_shape_applied = FALSE;
+      return;
+    }
+
+  region = create_rounded_corner_region (width, height, radius);
+  if (region != NULL)
+    {
+      gdk_x11_surface_set_bounding_shape (surface, region);
+      cairo_region_destroy (region);
+      priv->x11_shape_applied = TRUE;
+    }
+}
+#endif
+
+static void
+maybe_update_shape (GtkWindow *window)
+{
+#ifdef GDK_WINDOWING_X11
+  update_x11_bounding_shape (window);
+#endif
+}
